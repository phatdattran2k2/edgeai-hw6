FROM dustynv/pytorch:2.7-r36.4.0

ENV PIP_INDEX_URL=https://pypi.org/simple/
ENV PIP_EXTRA_INDEX_URL=
ENV YOLO_OFFLINE=1

RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN ORT_VER=$(python3 -c "import onnxruntime; print(onnxruntime.__version__)") && \
    STUB=/usr/local/lib/python3.10/dist-packages/onnxruntime_gpu-${ORT_VER}.dist-info && \
    mkdir -p "$STUB" && \
    printf "Metadata-Version: 2.1\nName: onnxruntime-gpu\nVersion: %s\n" "$ORT_VER" > "$STUB/METADATA" && \
    echo "Wheel-Version: 1.0\nGenerator: lab10-stub\nRoot-Is-Purelib: true" > "$STUB/WHEEL" && \
    : > "$STUB/RECORD"

# COPY inference_node.py .
# RUN mkdir -p /opt/models
# COPY best.pt /opt/models/

# RUN cd /opt/models && \
#     python3 -c "from ultralytics import YOLO; \
#     YOLO('best.pt', task='detect').export(format='engine', imgsz=320, half=True, opset=19)"

# NEW — Dockerfile.ci, deferred engine compile
COPY src/inference_node.py /app/
COPY src/mqtt_publisher.py /app/
COPY src/healthcheck.py /app/
COPY entrypoint.sh /app/
RUN chmod +x /app/entrypoint.sh && mkdir -p /opt/models
COPY best.pt /opt/models/
# No GPU work in this image. The TRT engine is compiled at container
# start by entrypoint.sh — see that file for rationale.
WORKDIR /app
ENTRYPOINT ["/app/entrypoint.sh"]

CMD ["python3", "inference_node.py"]